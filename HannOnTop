-- ========== EFEK: 8-BIT CROWN ==========
local function applyCrown()
    local head = getHead()
    if not head then notify("Head tidak ketemu") return end
    removeNamed("Hann_8BitCrown")

    local model = Instance.new("Model")
    model.Name = "Hann_8BitCrown"
    local gold = Color3.fromRGB(255, 205, 30)
    local dark = Color3.fromRGB(210, 150, 0)
    local px = 0.3
    local top = headTop(head)
    local origin = head.CFrame * CFrame.new(0, top + px / 2, 0)

    -- pita dasar: 5 piksel melebar (x -2..2), tebal 1 piksel
    for x = -2, 2 do
        newPart(model, "Band", Vector3.new(px, px, px * 4),
            (x % 2 == 0) and gold or dark, Enum.Material.Metal,
            origin * CFrame.new(x * px, 0, 0))
    end
    -- 3 ujung mahkota (x = -2, 0, 2), tinggi 2 piksel
    for _, x in ipairs({ -2, 0, 2 }) do
        for y = 1, 2 do
            newPart(model, "Spike", Vector3.new(px, px, px * 4), gold, Enum.Material.Metal,
                origin * CFrame.new(x * px, y * px, 0))
        end
    end
    -- permata merah di tengah pita (piksel)
    newPart(model, "Gem", Vector3.new(px, px, px * 4.2), Color3.fromRGB(230, 30, 40),
        Enum.Material.Neon, origin * CFrame.new(0, 0, 0))

    model.Parent = getChar()
    weldModel(model, head)
end

-- ========== R6: KORBLOX & HEADLESS (versi buatan sendiri) ==========
local function applyR6Body()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.RigType ~= Enum.HumanoidRigType.R6 then return end

    -- Headless: sembunyikan kepala + wajah
    local head = char:FindFirstChild("Head")
    if head then
        local t = state.headless and 1 or 0
        head.Transparency = t
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("Decal") or d:IsA("Texture") then d.Transparency = t end
        end
    end

    -- Korblox: kaki kanan diganti model tulang/armor gelap
    removeNamed("Hann_KorbloxR6")
    local leg = char:FindFirstChild("Right Leg")
    if not leg then return end
    if not state.korblox then
        leg.Transparency = 0
        return
    end

    leg.Transparency = 1
    local model = Instance.new("Model")
    model.Name = "Hann_KorbloxR6"
    local armor = Color3.fromRGB(25, 25, 32)
    local bone = Color3.fromRGB(210, 205, 190)

    newPart(model, "Thigh", Vector3.new(1, 0.9, 1), armor, Enum.Material.Metal,
        leg.CFrame * CFrame.new(0, 0.55, 0))
    newPart(model, "Knee", Vector3.new(0.7, 0.3, 0.7), Color3.fromRGB(150, 0, 0), Enum.Material.Neon,
        leg.CFrame * CFrame.new(0, 0.0, 0))
    newPart(model, "Shin", Vector3.new(0.35, 0.8, 0.35), bone, Enum.Material.SmoothPlastic,
        leg.CFrame * CFrame.new(0, -0.55, 0))
    newPart(model, "Foot", Vector3.new(0.8, 0.3, 1.1), armor, Enum.Material.Metal,
        leg.CFrame * CFrame.new(0, -0.85, -0.05))

    model.Parent = char
    weldModel(model, leg)
end

