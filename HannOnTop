    local snow = Instance.new("ParticleEmitter")
    snow.Rate = 25
    snow.Lifetime = NumberRange.new(1.2, 2)
    snow.Speed = NumberRange.new(0.5, 1.5)
    snow.SpreadAngle = Vector2.new(180, 180)
    snow.Acceleration = Vector3.new(0, -1.5, 0)
    snow.LightEmission = 0.8
    snow.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255), Color3.fromRGB(120, 200, 255))
    snow.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.35),
        NumberSequenceKeypoint.new(1, 0),
    })
    snow.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    })
    snow.Parent = fx

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(140, 210, 255)
    light.Range = 8
    light.Brightness = 1.5
    light.Parent = fx
end

local function applyFireHorns()
    local model, fx = buildHorns("Hann_FireHorns",
