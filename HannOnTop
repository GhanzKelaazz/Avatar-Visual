                    local ok, err = pcall(function()
                        local acc = game:GetService("InsertService"):LoadAsset(tonumber(id))
                        if acc then
                            for _, obj in ipairs(acc:GetChildren()) do
                                if obj:IsA("Accessory") then
                                    local newAcc = obj:Clone()
                                    hum:AddAccessory(newAcc)
                                end
                            end
                            acc:Destroy()
                        end
                    end)
                    if not ok then
                        warn("[Hann] Gagal load accessory " .. id .. ": " .. tostring(err))
                    end
                end
            end
        end

        Rayfield:Notify({ Title = "Hann", Content = "Asset terpasang!", Duration = 3, Image = 4483362458 })
    end
})

