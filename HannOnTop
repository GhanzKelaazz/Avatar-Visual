-- ========== UTILITY ==========
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHum()
    local char = getChar()
    return char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
end

local function getHead()
    return getChar():FindFirstChild("Head")
end

local function newPart(parent, name, size, color, material, cf)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Massless = true
    p.Anchored = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.CFrame = cf
    p.Parent = parent
    return p
end

local function weldModel(model, target)
    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            local w = Instance.new("WeldConstraint")
            w.Part0 = target
            w.Part1 = p
            w.Parent = p
        end
    end
end

local function removeNamed(name)
    local char = LocalPlayer.Character
    if not char then return end
    local old = char:FindFirstChild(name)
    if old then old:Destroy() end
end

-- tinggi puncak kepala relatif ke pusat Head (R6 = 1, R15 ~ 1.2 tinggi)
local function headTop(head)
    return head.Size.Y / 2
end

-- ========== BODY (Korblox / Headless / Copy) via HumanoidDescription ==========
local function snapshotBase()
    local hum = getHum()
    if hum then
        local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
        if ok then baseDesc = desc end
    end
end

local function loadAccessory(id)
    local hum = getHum()
    if not hum then return false end
    local ok, err = pcall(function()
        local asset = game:GetService("InsertService"):LoadAsset(id)
        for _, obj in ipairs(asset:GetDescendants()) do
            if obj:IsA("Accessory") then
                local c = obj:Clone()
                c.Name = "Hann_" .. c.Name
                hum:AddAccessory(c)
            end
        end
        asset:Destroy()
    end)
    if not ok then
        warn("[Hann] Gagal load accessory " .. tostring(id) .. ": " .. tostring(err))
    end
    return ok
end

local function clearExtraAccessories()
    local char = LocalPlayer.Character
    if not char then return end
    for _, a in ipairs(char:GetChildren()) do
        if a:IsA("Accessory") and a.Name:sub(1, 5) == "Hann_" then a:Destroy() end
    end
end

-- forward declaration
local applyEffects

local function render()
    local hum = getHum()
    if not hum then return end
    if not baseDesc then snapshotBase() end
    if not baseDesc then
        notify("Gagal ambil data avatar")
        return
    end

    local desc = baseDesc:Clone()
    -- R15: pakai asset asli lewat HumanoidDescription. R6: ditangani applyR6Body().
    if hum.RigType == Enum.HumanoidRigType.R15 then
        if state.korblox then desc.RightLeg = KORBLOX_RIGHT_LEG_ID end
        if state.headless then desc.Head = HEADLESS_HEAD_ID end
    end

    local ok, err = pcall(function() hum:ApplyDescription(desc) end)
    if not ok then
        warn("[Hann] ApplyDescription gagal: " .. tostring(err))
        notify("Gagal apply (pastikan avatar R15)")
        return
    end

    task.wait(0.3)
    for id in pairs(activeAccs) do loadAccessory(id) end
    applyEffects()
end

-- ========== EFEK: HORNS ==========
local function buildHorns(modelName, baseColor, tipColor, material)
    local head = getHead()
    if not head then return nil end
    removeNamed(modelName)

    local model = Instance.new("Model")
    model.Name = modelName
    local top = headTop(head)

    for _, side in ipairs({ -1, 1 }) do
        local seg1CF = head.CFrame
            * CFrame.new(side * 0.4, top + 0.2, 0)
            * CFrame.Angles(0, 0, -side * math.rad(12))
        local seg1 = newPart(model, "HornBase", Vector3.new(0.45, 0.7, 0.45), baseColor, material, seg1CF)

        local seg2CF = seg1CF
            * CFrame.new(0, 0.55, 0)
            * CFrame.Angles(0, 0, -side * math.rad(18))
        local seg2 = newPart(model, "HornMid", Vector3.new(0.32, 0.6, 0.32), baseColor, material, seg2CF)

        local seg3CF = seg2CF
            * CFrame.new(0, 0.5, 0)
            * CFrame.Angles(0, 0, -side * math.rad(18))
        newPart(model, "HornTip", Vector3.new(0.18, 0.5, 0.18), tipColor, material, seg3CF)
    end

    -- anchor efek di atas kepala
    local fx = newPart(model, "FxAnchor", Vector3.new(0.5, 0.5, 0.5), baseColor, Enum.Material.SmoothPlastic,
        head.CFrame * CFrame.new(0, top + 1.6, 0))
    fx.Transparency = 1

    model.Parent = getChar()
    weldModel(model, head)
    return model, fx
end

