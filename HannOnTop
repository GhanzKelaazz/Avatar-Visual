local animationIds = {
    ["Default (R6)"] = "rbxassetid://507768375",
    ["Default (R15)"] = "rbxassetid://507771019",
    ["Ninja"] = "rbxassetid://656117400",
    ["Toy"] = "rbxassetid://656121766",
    ["Zombie"] = "rbxassetid://616163682",
    ["Astronaut"] = "rbxassetid://891563461",
    ["Mage"] = "rbxassetid://707742142",
    ["Knight"] = "rbxassetid://657595757",
    ["Cartoony"] = "rbxassetid://656117400",
    ["Levitation"] = "rbxassetid://616006778"
}

local currentAnim = "Default (R6)"

local function applyAnimation(animName)
    local char = getChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then
        warn("[Hann] Animator tidak ditemukan")
        return
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        track:Stop()
    end

    local animId = animationIds[animName]
    if not animId then return end

    local anim = Instance.new("Animation")
    anim.AnimationId = animId

    local ok, trackOrErr = pcall(function()
        local track = animator:LoadAnimation(anim)
        track:Play()
        return track
    end)
    if not ok then
        warn("[Hann] Gagal load animasi: " .. tostring(trackOrErr))
    end
end

