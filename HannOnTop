local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- FIX: cari limb support R6 & R15 sekaligus, plus kasih tau kalau gagal
local function getLimb(char, r6Name, r15Name)
    local part = char:FindFirstChild(r6Name) or (r15Name and char:FindFirstChild(r15Name))
    if not part then
        warn("[Hann] Part tidak ditemukan: " .. r6Name .. (r15Name and (" / " .. r15Name) or ""))
    end
    return part
end

local function getLeg(char, side)
    if side == "left" then
        return getLimb(char, "Left Leg", "LeftUpperLeg")
    else
        return getLimb(char, "Right Leg", "RightUpperLeg")
    end
end

local function getHead(char)
    return getLimb(char, "Head", "Head")
end

local function createPart(parent, name, size, color, cframe)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.Neon
    part.CanCollide = false
    part.CanQuery = false
    part.Anchored = false
    part.Massless = true
    part.CFrame = cframe
    part.Parent = parent
    return part
end

-- weld helper dengan sedikit delay supaya CFrame limb sudah settle
local function weldChildren(model, targetLimb)
    task.wait() -- 1 frame, biar CFrame target part stabil dulu
    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = targetLimb
            weld.Part1 = p
            weld.Parent = p
        end
    end
end

-- ========== VISUAL: KORBLOX ==========
local korbloxLeft = false
local korbloxRight = false

local function applyKorblox(side)
    local char = getChar()
    local leg = getLeg(char, side)
    if not leg then
        Rayfield:Notify({ Title = "Hann", Content = "Leg part tidak ketemu (cek rig R6/R15)", Duration = 3 })
        return
    end

    local old = leg:FindFirstChild("HannKorblox")
    if old then old:Destroy() end

    local korblox = Instance.new("Model")
    korblox.Name = "HannKorblox"

    local mainPart = createPart(korblox, "Main", leg.Size, Color3.fromRGB(20, 20, 25), leg.CFrame)
    mainPart.Transparency = 0.3

    for i = 1, 3 do
        local spike = createPart(korblox, "Spike" .. i, Vector3.new(0.3, 0.8, 0.3),
            Color3.fromRGB(150, 0, 0),
            leg.CFrame * CFrame.new(0, -0.5 - i * 0.3, 0))
        spike.Shape = Enum.PartType.Cylinder
        spike.Orientation = Vector3.new(0, 0, 90)
    end

    korblox.Parent = leg
    weldChildren(korblox, leg)
end

local function removeKorblox(side)
    local char = getChar()
    local leg = getLeg(char, side)
    if not leg then return end
    local old = leg:FindFirstChild("HannKorblox")
    if old then old:Destroy() end
end

